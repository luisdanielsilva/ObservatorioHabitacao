    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@olhovivo/engine": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5"
