{
  "name": "@olhovivo/db",
  "version": "0.1.0",
  "private": true,
  "description": "SQLite schema, migrations, seed data and queries",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
