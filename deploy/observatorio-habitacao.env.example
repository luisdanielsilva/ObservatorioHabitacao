# Copy to /etc/observatorio-habitacao.env (readable by root and deploy only: chmod 640).
DATABASE_PATH=/var/www/olhovivo/data/observatorio-habitacao.db
NEXT_PUBLIC_SITE_URL=https://observatoriohabitacao.pt
# Comma-separated domains whose terms allow reading listings. Empty = link reader off.
LINK_READER_ALLOWED_DOMAINS=
BACKUP_DIR=/var/www/olhovivo/data/backups
BACKUP_KEEP=14
# Transactional email (Resend). Without a key, emails are only written to the app log.
RESEND_API_KEY=
EMAIL_FROM=Observatório Habitação <noreply@observatoriohabitacao.pt>
# Where new sales-support requests are announced. Empty = no notification.
TEAM_EMAIL=
# Link reader: with a key, Claude reads listing pages (only from LINK_READER_ALLOWED_DOMAINS);
# without one, only structured data published by the page is used.
ANTHROPIC_API_KEY=
# Property photos of saved scenarios. Default: data/photos next to the database.
# PHOTOS_DIR=
