# Copy to /etc/olhovivo.env (readable by root and deploy only: chmod 640).
DATABASE_PATH=/var/www/olhovivo/data/olhovivo.db
NEXT_PUBLIC_SITE_URL=https://olhovivo.pt
# Comma-separated domains whose terms allow reading listings. Empty = link reader off.
LINK_READER_ALLOWED_DOMAINS=
BACKUP_DIR=/var/www/olhovivo/data/backups
BACKUP_KEEP=14
