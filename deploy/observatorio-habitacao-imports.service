# Data imports: INE prices and rents, CAOP boundaries, Euribor (WBS 4.3.5).
[Unit]
Description=Observatório Habitação data imports

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/var/www/olhovivo
EnvironmentFile=/etc/observatorio-habitacao.env
ExecStart=/usr/bin/npm run import:all -w @observatorio-habitacao/db
# Imports are heavy for this VPS; keep the web app responsive.
Nice=10
IOSchedulingClass=idle
